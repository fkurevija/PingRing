<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base background: a deep violet, one tonal step off the app's own dark
         surface so the icon belongs to the palette rather than sitting beside
         it as a different product. -->
    <path
        android:fillColor="#121016"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Concentric radar rings, each a further step down the same violet hue.
         The greys here are tinted rather than neutral: a true grey beside a
         saturated violet reads as a different material. -->
    <path
        android:fillColor="#2A2540"
        android:pathData="M9,54 a45,45 0 1,0 90,0 a45,45 0 1,0 -90,0" />

    <path
        android:fillColor="#3E3566"
        android:pathData="M19,54 a35,35 0 1,0 70,0 a35,35 0 1,0 -70,0" />

    <!-- The core is the brand colour itself: the one place the icon shows the
         primary at full strength, so the launcher is recognisable at a glance. -->
    <path
        android:fillColor="#5C2BD9"
        android:pathData="M29,54 a25,25 0 1,0 50,0 a25,25 0 1,0 -50,0" />

</vector>
